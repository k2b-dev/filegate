# TLS edge for the upload benchmarks. Only reason it exists: HTTP/2 needs TLS,
# so the h1-vs-h2 comparison has to run through the same proxy in both runs to
# stay apples-to-apples.
{
	auto_https disable_redirects
	admin off
}

https://edge {
	tls internal
	reverse_proxy filegate:8080 {
		flush_interval -1
	}
}
